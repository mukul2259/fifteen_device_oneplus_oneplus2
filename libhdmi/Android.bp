cc_library_shared {
    name: "libhdmi",
    vendor: true,

    header_libs: [
        "display_headers",
        "generated_kernel_headers",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libEGL",
        "libqdutils",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wconversion",
        "-Wall",
        "-Werror", 
        "-Wno-sign-conversion",
        "-DVENUS_COLOR_FORMAT",
        "-DMDSS_TARGET",
        "-DLOG_TAG=\"qdhdmi\"",
        "-Wno-float-conversion",
    ],

    srcs: ["hdmi.cpp"],
}
