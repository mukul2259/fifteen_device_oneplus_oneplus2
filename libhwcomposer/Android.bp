cc_library_shared {
    name: "hwcomposer.qcom",
    vendor: true,
    defaults: ["display_defaults"],
    relative_install_path: "hw",
    cflags: [
        "-DLOG_TAG=\"qdhwcomposer\"",
        "-Wno-absolute-value",
        "-Wno-float-conversion",
        "-Wno-unused-parameter",
        "-DDYNAMIC_FPS",
    ],
    srcs: [
        "hwc.cpp",
        "hwc_utils.cpp",
        "hwc_uevents.cpp",
        "hwc_vsync.cpp",
        "hwc_fbupdate.cpp",
        "hwc_mdpcomp.cpp",
        "hwc_copybit.cpp",
        "hwc_qclient.cpp",
        "hwc_dump_layers.cpp",
        "hwc_ad.cpp",
        "hwc_virtual.cpp",
    ],
    shared_libs: [
        "libEGL",
        "liboverlay",
        "libhdmi",
        "libqdutils",
        "libhardware",
        "libhardware_legacy",
        "libdl",
        "libqservice",
        "libsync",
        "libbinder",
        "libui",
    ],
    header_libs: ["generated_kernel_headers"],
}
