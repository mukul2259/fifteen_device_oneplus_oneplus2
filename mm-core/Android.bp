cc_library_shared {
    name: "libOmxCore",
    vendor: true,

    srcs: [
        "src/common/omx_core_cmp.cpp",
        "src/common/qc_omx_core.c",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
            "msm8992": ["src/msm8992/registry_table_android.c"],
            "msm8994": ["src/msm8994/registry_table_android.c"],
        default: [],
    }),

    cflags: [
        "-fno-inline",
        "-fno-short-enums",
        "-D_ANDROID_",
    ],

    local_include_dirs: [
        "src/common",
    ],

    export_header_lib_headers: [
        "libomxcore_headers",
    ],

    shared_libs: [
        "liblog",
        "libdl",
    ],
}

cc_library_shared {
    name: "libmm-omxcore",
    vendor: true,

    srcs: [
        "src/common/omx_core_cmp.cpp",
        "src/common/qc_omx_core.c",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
            "msm8992": ["src/msm8992/registry_table.c"],
            "msm8994": ["src/msm8994/registry_table.c"],
    }),

    cflags: [
        "-fno-inline",
        "-fno-short-enums",
        "-D_ANDROID_",
    ],

    local_include_dirs: [
        "src/common",
        "inc",
    ],

    export_header_lib_headers: [
        "libomxcore_headers",
    ],

    shared_libs: [
        "liblog",
        "libdl",
    ],
}

cc_library_headers {
    name: "libomxcore_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
